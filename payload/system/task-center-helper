BASE = runtime.BASE
USERS = BASE / 'users'
SELF = BASE / 'minas-helper'
DOCKER = '/data/docker/docker'
KINDS = {'reboot', 'docker_start', 'docker_stop', 'docker_restart', 'docker_image', 'script', 'cleanup'}
LABELS = {'reboot': '重启 NAS', 'docker_start': '启动容器', 'docker_stop': '停止容器', 'docker_restart': '重启容器', 'docker_image': '从本地镜像创建/启动容器', 'script': '执行脚本'}
MAX_LOG = 65536
MAINTENANCE = Path(__file__).resolve().parent / 'task_maintenance.py'
RETRY_KINDS = {'docker_start', 'script'}

def valid_user(user):
    if not re.fullmatch(r'u[0-9]+', user or ''):
        raise ValueError('无效用户')
    pwd.getpwnam(user)
    return user

def valid_id(value):
    if not re.fullmatch(r'[a-f0-9]{32}', str(value)):
        raise ValueError('无效任务/记录标识')
    return str(value)

def home(user):
    return USERS / valid_user(user)

def boot_id():
    return Path('/proc/sys/kernel/random/boot_id').read_text().strip()

def atomic(path, value):
    tmp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as out:
        json.dump(value, out, ensure_ascii=False)
        out.flush()
        os.fsync(out.fileno())
    os.replace(str(tmp), str(path))

@contextlib.contextmanager
def database(user):
    directory = home(user)
    if not directory.is_dir() or directory.is_symlink():
        raise ValueError('调度数据尚未初始化')
    with open(str(directory / 'lock'), 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = json.loads((directory / 'state.json').read_text())
        yield state
        atomic(directory / 'state.json', state)

