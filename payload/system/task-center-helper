    specs = [
        ('每周重启 NAS', 'reboot', '周日凌晨 04:30 重启整台 NAS，会中断所有服务。', {'type': 'weekly', 'time': '04:30', 'weekday': 6}),
        ('每天启动指定容器', 'docker_start', '选择已存在的容器，例如 Syncthing；不会拉取镜像。', {'type': 'daily', 'time': '08:00'}),
