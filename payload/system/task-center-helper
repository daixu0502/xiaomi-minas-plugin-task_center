    result = [{'template': str(i), 'name': n, 'kind': k, 'description': d, 'schedule': s, 'params': {}, 'timeout': 300, 'waitPool': True, 'enabled': False} for i, (n, k, d, s) in enumerate(specs)]
    for mode, label, days in [('logs', '清理过期日志', 30), ('temp', '清理临时文件', 7), ('recycle', '清理指定回收站旧文件', 30)]:
