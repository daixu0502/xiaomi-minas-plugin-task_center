MUTATIONS = {'engine_action', 'container_action', 'container_upgrade', 'container_bulk_action',
             'container_create', 'image_pull', 'image_remove', 'volume_create', 'volume_remove'}


def dispatch(request):
    if not isinstance(request, dict):
        raise ApiError("请求格式无效")
    action = request.get('action')
    handler = ACTIONS.get(action)
    if not handler:
        raise ApiError("未知操作")
    # One lock covers the full operation, including async children. Read/poll
    # requests do not wait behind long pulls and upgrades.
    with runtime.docker_transaction() if action in MUTATIONS else contextlib.nullcontext():
        return handler(request)


def main():
    if os.geteuid() != 0:
        raise ApiError("权限助手必须以 root 身份运行")
    if len(sys.argv) != 1:
        raise ApiError("权限助手不接受命令行参数")
    raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
    if len(raw) > MAX_REQUEST:
        raise ApiError("请求过大")
    try:
        request = json.loads(raw.decode("utf-8")) if raw.strip() else {}
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise ApiError("请求不是有效 JSON")
    if not isinstance(request, dict):
        raise ApiError("请求格式无效")
    payload = dispatch(request)
    payload["ok"] = True
    reply(payload)


if __name__ == "__main__":
    try:
        main()
    except ApiError as error:
        reply({"ok": False, "error": str(error)})
    except Exception as error:
        reply({"ok": False, "error": f"内部错误：{error}"})
